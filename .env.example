# Local development never sends email. Do not paste secrets into browser variables.
APP_ENV=development
PUBLIC_ORIGIN=http://127.0.0.1:5174
PORT=4102
# Set to use a separate PostgreSQL server; otherwise local PGlite persists in .data.
DATABASE_URL=
# Required for production; set a long random value in secret storage.
SESSION_SECRET=
# Live publication requires approved content, legal notice, identity and mail integrations.
